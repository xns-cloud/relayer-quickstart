# XNS Relayer — environment overrides
#
# Copy this file to .env and uncomment any line you want to change.
# After editing, apply with: docker compose up -d
#
# All keys are optional — the defaults (shown in comments) work out of the box.
# Never commit your .env — it is ignored by .gitignore for that reason.

# ---- Ports ----
# Uncomment if 8888, 9000, or 9443 are already in use on your machine.
#UI_PORT=8888
#S3_PORT=9000
#S3_TLS_PORT=9443
